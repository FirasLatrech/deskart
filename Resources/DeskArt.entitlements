<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required. The hardened runtime blocks Apple Events outright without
	     this: macOS refuses with -1743 and never even shows the consent
	     prompt, so Finder is unreachable no matter what the user allows. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
